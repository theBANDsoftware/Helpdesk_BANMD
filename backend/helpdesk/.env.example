# Kopiera den här filen till .env i samma mapp (backend/helpdesk/.env) och fyll i.
# .env finns i .gitignore och ska aldrig committas. Uppgifterna får du av David.
# DB_URL är bara adress, port och databas. jdbc:mariadb:// står redan i
# application.properties.
DB_URL=VPS-ADRESS:3306/helpdesk
DB_USERNAME=ditt-anvandarnamn
DB_PASSWORD=ditt-losenord

# Fillagring för bifogade skärmdumpar (TB-35, beslut 11). Nycklarna får du av Mustafa.
S3_ENDPOINT=https://s3.eu-central-003.backblazeb2.com
S3_REGION=eu-central-003
S3_BUCKET=helpdesk-banmd-attachments
S3_ACCESS_KEY=din-keyID
S3_SECRET_KEY=din-applicationKey
